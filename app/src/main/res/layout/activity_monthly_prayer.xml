<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- Header Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:src="@drawable/baseline_location_on_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ankara"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="@+id/imageView" />

        <TextView
            android:id="@+id/hijri_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="12 Şaban 1446"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/hicriDateIcon"
            app:layout_constraintEnd_toStartOf="@+id/hicriDateIcon"
            app:layout_constraintTop_toTopOf="@+id/hicriDateIcon" />

        <ImageView
            android:id="@+id/hicriDateIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:src="@drawable/baseline_calendar_month_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Prayer Time Image -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <ImageView
            android:id="@+id/prayer_time_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/prayer_time_image_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/gunes_mountly" />

        <!-- Remaining Time -->
        <TextView
            android:id="@+id/remaining_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tomorrow_b"
            android:layout_marginTop="3dp"
            android:layout_marginStart="10dp"
            android:text="Güneş"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
             />

        <!-- Remaining Time -->
        <TextView
            android:id="@+id/remaining_time_label_ek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tomorrow_b"
            android:layout_marginTop="22dp"
            android:layout_marginStart="10dp"
            android:text="vaktine kalan"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            />

        <!-- Remaining Time -->
        <TextView
            android:id="@+id/remaining_time_monthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tomorrow_b"
            android:layout_marginTop="35dp"
            android:layout_marginStart="10dp"
            android:text="08:26:11"
            android:textColor="@android:color/white"
            android:textSize="27sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cardView" />
    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_current_time_monthly"
        android:layout_width="350dp"
        android:layout_height="100dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="@+id/cardView"
        app:layout_constraintEnd_toEndOf="@id/cardView"
        app:layout_constraintStart_toStartOf="@+id/cardView"
        app:layout_constraintTop_toBottomOf="@+id/cardView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp">

            <!-- İmsak -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:id="@+id/imsak_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/imsak_m_icon"
                    app:tint="@color/icon_color" />
                <TextView
                    android:id="@+id/imsak_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İmsak"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/imsak_time_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:30"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Güneş -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:id="@+id/gunes_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:tint="@color/icon_color"
                    android:src="@drawable/gunes_m_icon" />
                <TextView
                    android:id="@+id/gunes_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Güneş"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/gunes_time_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:45"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Öğle -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:id="@+id/ogle_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:tint="@color/icon_color"
                    android:src="@drawable/ogle_m_icon" />
                <TextView
                    android:id="@+id/ogle_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Öğle"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/ogle_time_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:30"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- İkindi -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:id="@+id/ikindi_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:tint="@color/icon_color"
                    android:src="@drawable/ikindi_m_icon" />
                <TextView
                    android:id="@+id/ikindi_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İkindi"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/ikindi_time_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15:45"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Akşam -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:id="@+id/aksam_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:tint="@color/icon_color"
                    android:src="@drawable/aksam_m_icon" />
                <TextView
                    android:id="@+id/aksam_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akşam"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/aksam_time_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:20"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Yatsı -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <ImageView
                    android:id="@+id/yatsi_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:tint="@color/icon_color"
                    android:src="@drawable/yatsi_m_icon" />
                <TextView
                    android:id="@+id/yatsi_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yatsı"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/yatsi_time_monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:00"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>



    <!-- Prayer Times RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/prayer_times_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="5dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView_current_time_monthly"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout> 