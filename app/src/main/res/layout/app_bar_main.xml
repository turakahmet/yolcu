<?xml version="1.0" encoding="utf-8"?><!--
    Ana ekran üst bölümü (tüm menü ekranlarında ortak). HomeHeader yönetir:
    - Ana Sayfa: cami manzaralı büyük başlık (gölgeli büyük geri sayım ve cam vakit şeridi);
      arka plan fotoğrafını HomeHeader kod ile verir (HeaderPhotoDrawable). İçerik kaydırılınca
      yukarı çekilir; vakit şeridi üstte sabit kalır. Aşağı inerken önce içerik, en üstte başlık açılır.
    - Diğer ekranlar: ince yeşil çubuk (ekran adı + küçük geri sayım), kaydırma yok.
    Kimlikler MainActivity ve PrayerTimesPanel tarafından kullanılır; değiştirmeyin.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_app_header"
        android:theme="@style/Theme.Yolcu.AppBarOverlay"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:layout_scrollFlags="scroll|snap"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Yolcu.HeaderTitle" />

        <!-- Geri sayım paneli + vakit şeridi (HomeHeader ayarlar) -->
        <LinearLayout
            android:id="@+id/home_header_panels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|snap">

            <!-- Geri sayım: Ana Sayfa'da camsız, büyük ve gölgeli; fotoğrafta caminin solundaki açık
                 alanda durur (sağdaki boşluk camiyi açıkta bırakır). Diğer ekranlarda küçük ve ortada.
                 Dokununca aylık vakit takvimi. -->
            <LinearLayout
                android:id="@+id/remain_time_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/home_panel_margin"
                android:layout_marginEnd="@dimen/home_panel_margin"
                android:baselineAligned="false"
                android:contentDescription="@string/home_countdown_cd"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Üstte ortalı sıradaki vaktin ikonu, iki yanında ince çizgi (yalnızca Ana Sayfa) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/home_countdown_line_start"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/color_countdown_line" />

                        <ImageView
                            android:id="@+id/home_countdown_icon"
                            android:layout_width="@dimen/home_countdown_icon"
                            android:layout_height="@dimen/home_countdown_icon"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_prayer_ogle"
                            app:tint="@color/color_highlight" />

                        <View
                            android:id="@+id/home_countdown_line_end"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/color_countdown_line" />
                    </LinearLayout>

                    <!-- Kerahat vaktinde vakit etiketinin üstünde küçük uyarı; diğer zamanlarda gizli
                         (PrayerTimesPanel yönetir) -->
                    <TextView
                        android:id="@+id/home_countdown_kerahat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:letterSpacing="0.04"
                        android:shadowColor="@color/color_header_text_shadow"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:text="@string/kerahat_in_progress"
                        android:textColor="@color/color_countdown_kerahat"
                        android:textSize="@dimen/home_countdown_kerahat_text"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Vakte kalan etiketi: her durumda aynı boyut -->
                    <TextView
                        android:id="@+id/toolbarKalanSureLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:shadowColor="@color/color_header_text_shadow"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:text="@string/empty_text"
                        android:textColor="@color/color_on_header"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Ana Sayfa: saat / dakika / saniye ayrı cam kutularda -->
                    <LinearLayout
                        android:id="@+id/home_countdown_boxes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/home_countdown_hours"
                            layout="@layout/item_countdown_box" />

                        <TextView
                            style="@style/HomeCountdownSeparator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/home_countdown_minutes"
                            layout="@layout/item_countdown_box" />

                        <TextView
                            style="@style/HomeCountdownSeparator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/home_countdown_seconds"
                            layout="@layout/item_countdown_box" />
                    </LinearLayout>

                    <!-- Diğer ekranlarda tek satır sayaç (Ana Sayfa'da gizli) -->
                    <TextView
                        android:id="@+id/toolbarKalanSure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semi_condensed_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:shadowColor="@color/color_header_text_shadow"
                        android:shadowDy="3"
                        android:shadowRadius="10"
                        android:text="@string/empty_text"
                        android:textColor="@color/color_on_header"
                        android:textSize="32sp" />

                    <!-- Vakit yoksa veya şehir seçilmemişse: yenile / şehir seç -->
                    <LinearLayout
                        android:id="@+id/location_refresh_Layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/refresh_button"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/refresh_img"
                            android:src="@drawable/baseline_refresh_24"
                            app:tint="@color/color_on_header" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ana Sayfa'da caminin göründüğü sağ taraf boş kalır -->
                <Space
                    android:id="@+id/home_countdown_spacer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.8" />
            </LinearLayout>

            <!-- Ana Sayfa: sayaç ile vakit şeridi arasındaki cami manzarası boşluğu. Yüksekliğini
                 HomeHeader ekran genişliğine oranla hesaplar (her cihazda aynı oran). Sayaçla birlikte
                 yukarı kayar; şerit sabitlenince üstünde boşluk kalmaz. -->
            <Space
                android:id="@+id/home_strip_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />
        </LinearLayout>

        <!-- Vakit şeridi: sıradaki vakit altın dolgulu vurgulanır (PrayerTimesPanel).
             Kaydırma bayrağı yok: Ana Sayfa'da içerik yukarı kayınca toolbar ve sayaç gider, şerit üstte
             sabit kalır; içerik şeridin altından geçer. -->
        <LinearLayout
            android:id="@+id/prayer_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/home_panel_margin"
            android:layout_marginTop="@dimen/home_strip_pinned_gap"
            android:layout_marginEnd="@dimen/home_panel_margin"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_home_glass"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/imsak_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_prayer_imsak"
                    app:tint="@color/color_on_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/imsak"
                    android:textColor="@color/color_on_header"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/imsak_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/empty_text"
                    android:textColor="@color/color_on_header"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gunes_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_prayer_gunes"
                    app:tint="@color/color_on_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/gunes"
                    android:textColor="@color/color_on_header"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/gunes_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/empty_text"
                    android:textColor="@color/color_on_header"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ogle_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_prayer_ogle"
                    app:tint="@color/color_on_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/ogle"
                    android:textColor="@color/color_on_header"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ogle_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/empty_text"
                    android:textColor="@color/color_on_header"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ikindi_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_prayer_ikindi"
                    app:tint="@color/color_on_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/ikindi"
                    android:textColor="@color/color_on_header"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ikindi_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/empty_text"
                    android:textColor="@color/color_on_header"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aksam_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_prayer_aksam"
                    app:tint="@color/color_on_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/aksam"
                    android:textColor="@color/color_on_header"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aksam_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/empty_text"
                    android:textColor="@color/color_on_header"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/yatsi_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_prayer_yatsi"
                    app:tint="@color/color_on_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/yatsi"
                    android:textColor="@color/color_on_header"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/yatsi_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/empty_text"
                    android:textColor="@color/color_on_header"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
