<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_bottom"
        android:theme="@style/Theme.Yolcu.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:textColor="@color/white" />

        <!-- Sonraki vakite kalan -->
        <LinearLayout
            android:id="@+id/remain_time_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/remain_namaz_time_1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toolbarKalanSureLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/empty_text"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/toolbarKalanSure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/tomorrow_b"
                android:text="@string/empty_text"
                android:textColor="@color/white"
                android:textSize="28sp" />
        </LinearLayout>
        <!-- Namaz vakitleri düzeni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_bottom"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- İmsak -->
            <LinearLayout
                android:id="@+id/imsak_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/imsak_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/testVakit_icon"
                    android:src="@drawable/imsak_m_icon"
                    app:tint="@color/icon_color" />

                <TextView
                    android:id="@+id/imsak_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/imsak"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/imsak_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Güneş -->
            <LinearLayout
                android:id="@+id/gunes_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/gunes_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/testVakit_icon"
                    android:src="@drawable/gunes_m_icon"
                    app:tint="@color/icon_color" />

                <TextView
                    android:id="@+id/gunes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/gunes"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gunes_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Öğle -->
            <LinearLayout
                android:id="@+id/ogle_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/ogle_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/testVakit_icon"
                    android:src="@drawable/ogle_m_icon"
                    app:tint="@color/icon_color" />

                <TextView
                    android:id="@+id/ogle_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ogle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ogle_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- İkindi -->
            <LinearLayout
                android:id="@+id/ikindi_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/ikindi_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/testVakit_icon"
                    android:src="@drawable/ikindi_m_icon"
                    app:tint="@color/icon_color" />

                <TextView
                    android:id="@+id/ikindi_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ikindi"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ikindi_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Akşam -->
            <LinearLayout
                android:id="@+id/aksam_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/aksam_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/testVakit_icon"
                    android:src="@drawable/aksam_m_icon"
                    app:tint="@color/icon_color" />

                <TextView
                    android:id="@+id/aksam_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aksam"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aksam_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Yatsı -->
            <LinearLayout
                android:id="@+id/yatsi_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/yatsi_time_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/testVakit_icon"
                    android:src="@drawable/yatsi_m_icon"
                    app:tint="@color/icon_color" />

                <TextView
                    android:id="@+id/yatsi_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yatsi"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/yatsi_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Konum -->
            <LinearLayout
                android:id="@+id/location_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/location_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/testVakit_icon"
                    android:src="@drawable/appbar_location"
                    app:tint="@color/icon_color" />

                <TextView
                    android:id="@+id/location_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/konum"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/location_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_text"
                    android:textStyle="bold" />
            </LinearLayout>
            <!-- Konum refresh -->
            <LinearLayout
                android:id="@+id/location_refresh_Layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/refresh_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/refresh_img"
                    android:src="@drawable/baseline_refresh_24" />

            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>