<?xml version="1.0" encoding="utf-8"?>
<!-- Ana Sayfa geri sayımında tek cam kutu: büyük rakam + altında birim (SAAT / DAKİKA / SANİYE).
     Birim yazısını HomeHeader verir. Rakam kutuya sığmazsa küçülür (büyük yazı boyutu, dar ekran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_home_countdown_box"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/countdown_box_value"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_countdown_box_value_height"
        android:fontFamily="@font/barlow_semi_condensed_semibold"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="@color/color_header_text_shadow"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:text="@string/countdown_box_empty"
        android:textColor="@color/color_on_header"
        android:textSize="@dimen/home_countdown_text"
        app:autoSizeMaxTextSize="@dimen/home_countdown_text"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform" />

    <TextView
        android:id="@+id/countdown_box_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textColor="@color/color_on_header_secondary"
        android:textSize="11sp" />
</LinearLayout>
