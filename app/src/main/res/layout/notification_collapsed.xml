<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/notification_collapsed_root"
    android:foreground="?attr/selectableItemBackground"
    android:theme="@style/Theme.Yolcu">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Kalan süre "03:" + "20:11": saat metin, dakika:saniye sistem kronometresi (uygulama
                 saniyede bir bildirim göndermez; saniyeyi sistem akıtır) -->
            <TextView
                android:id="@+id/remainingHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/remainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/remainingTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/loading_data"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nextPrayerInfoRemainCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_data"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/hicriAy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_data"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout> 