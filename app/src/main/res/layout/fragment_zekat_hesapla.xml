<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp">


    <!-- RadioGroup ve RadioButtonlar -->
    <TextView
        android:id="@+id/radioGroupLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Varlık Tipi"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/radioGroupVarlikTipi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RadioGroup
        android:id="@+id/radioGroupVarlikTipi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/radioGroupLabel"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/radioButtonVarliklar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Varlıklar" />

        <RadioButton
            android:id="@+id/radioButtonBorclar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Borçlar" />
    </RadioGroup>

    <ImageButton
        android:id="@+id/zekatInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@null"
        android:src="@drawable/baseline_info_24_gray"
        app:layout_constraintBottom_toBottomOf="@+id/radioGroupVarlikTipi"
        app:layout_constraintEnd_toEndOf="@+id/radioGroupVarlikTipi"
        app:layout_constraintTop_toTopOf="@+id/radioGroupVarlikTipi"
        tools:ignore="ContentDescription" />


    <TextView
        android:id="@+id/spinnerIconLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Varlık Türü"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/spinnerVarlikTuru"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroupVarlikTipi" />

    <ImageView
        android:id="@+id/spinnerIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Dropdown icon"
        android:padding="8dp"
        android:src="@drawable/baseline_keyboard_arrow_down_24"
        app:layout_constraintBottom_toBottomOf="@+id/spinnerVarlikTuru"
        app:layout_constraintEnd_toEndOf="@+id/spinnerVarlikTuru"
        app:layout_constraintTop_toTopOf="@+id/spinnerVarlikTuru" />

    <Spinner
        android:id="@+id/spinnerVarlikTuru"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="5dp"
        android:background="@drawable/spinner_background"
        android:popupBackground="@color/white"
        android:spinnerMode="dropdown"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/radioGroupVarlikTipi"
        app:layout_constraintTop_toBottomOf="@id/radioGroupVarlikTipi" />

    <TextView
        android:id="@+id/spinnerAltTuruLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Döviz Türü"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/spinnerAltTuru"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spinnerAltTuru" />

    <ImageView
        android:id="@+id/spinnerAltIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Dropdown icon"
        android:padding="8dp"
        android:src="@drawable/baseline_keyboard_arrow_down_24"
        app:layout_constraintBottom_toBottomOf="@+id/spinnerAltTuru"
        app:layout_constraintEnd_toEndOf="@+id/spinnerAltTuru"
        app:layout_constraintTop_toTopOf="@+id/spinnerAltTuru" />

    <Spinner
        android:id="@+id/spinnerAltTuru"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/spinner_background"
        android:popupBackground="@color/white"
        android:spinnerMode="dropdown"
        android:textColor="@color/black"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@+id/spinnerIcon"
        app:layout_constraintStart_toStartOf="@+id/spinnerVarlikTuru"
        app:layout_constraintTop_toBottomOf="@+id/spinnerVarlikTuru" />

    <TextView
        android:id="@+id/kurBilgileriTutarLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kur Değeri"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/kurBilgileriTutar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/kurBilgileriTutar" />

    <EditText
        android:id="@+id/kurBilgileriTutar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:inputType="numberDecimal"
        android:maxLength="10"
        app:layout_constraintEnd_toStartOf="@+id/kurBilgileriDegistirCheckBox"
        app:layout_constraintStart_toStartOf="@+id/spinnerVarlikTuru"
        app:layout_constraintTop_toBottomOf="@id/spinnerAltTuru" />

    <CheckBox
        android:id="@+id/kurBilgileriDegistirCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Değiştir"
        app:layout_constraintBottom_toBottomOf="@+id/kurBilgileriTutar"
        app:layout_constraintEnd_toEndOf="@+id/spinnerIcon"
        app:layout_constraintTop_toTopOf="@+id/kurBilgileriTutar" />

    <EditText
        android:id="@+id/editTextTutar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tutar"
        android:inputType="numberDecimal"
        android:maxLength="14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/kurBilgileriTutar" />

    <Button
        android:id="@+id/buttonVarlikEkle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Varlık Ekle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextTutar" />

    <ScrollView
        android:id="@+id/listViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/toplamVarlik"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonVarlikEkle">

        <ListView
            android:id="@+id/listViewVarliklar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </ScrollView>

    <View
        android:id="@+id/horizantalLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lineColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/buttonPaylas" />

    <TextView
        android:id="@+id/toplamVarlik"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        android:paddingTop="5dp"
        android:text="Varlık Toplam: 0"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/textViewZekatSonuc"
        app:layout_constraintEnd_toStartOf="@id/buttonPaylas"
        app:layout_constraintStart_toStartOf="parent" />


    <TextView
        android:id="@+id/textViewZekatSonuc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        android:text="Zekat tutar: 0"
        android:textColor="@color/redAlertColor"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonPaylas"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/buttonPaylas"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="5dp"
        android:background="@null"
        android:contentDescription="exportimage"
        android:scaleType="centerCrop"
        android:src="@drawable/baseline_sim_card_download_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>