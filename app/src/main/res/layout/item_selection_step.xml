<?xml version="1.0" encoding="utf-8"?>
<!-- Adım göstergesinde tek adım: daire + iki yanında çizgi + altında etiket.
     Genişlik ekranı üçe böler; uzun etiket iki satıra sarılır, kesilmez. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/lineStart"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@color/step_pending" />

        <TextView
            android:id="@+id/circle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_step_circle"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:backgroundTint="@color/step_current"
            tools:text="1" />

        <View
            android:id="@+id/lineEnd"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@color/step_pending" />
    </LinearLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textSize="12sp"
        tools:text="TÜRKİYE" />
</LinearLayout>
