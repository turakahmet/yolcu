<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/settings_screen_padding">

        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_prayer_city" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.islamyolu.app.settings.SettingsRowView
                android:id="@+id/rowPrayerCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/baseline_mosque_24"
                app:rowTitle="@string/city_selection_title" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_weather_city" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowWeatherCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/baseline_location_on_24"
                    app:rowSubtitle="@string/settings_weather_city_subtitle"
                    app:rowTitle="@string/locationSettingLabel"
                    app:rowType="info" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateLocationButton"
                    style="@style/Widget.Yolcu.Settings.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_row_padding_horizontal"
                    android:layout_marginEnd="@dimen/settings_row_padding_horizontal"
                    android:layout_marginBottom="@dimen/settings_row_padding_horizontal"
                    android:text="@string/settings_update_from_location"
                    app:icon="@drawable/baseline_near_me_24"
                    app:iconTint="@color/settings_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
