<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Altın Miktarı -->
    <ImageView
        android:id="@+id/coinImage_matches"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/coin_2"
        app:layout_constraintEnd_toStartOf="@id/gold_amount_text_matches"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/gold_amount_text_matches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="35dp"
        android:fontFamily="@font/tomorrow_b"
        android:text="500"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/coinImage_matches"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/gold_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/tomorrow_b"
        android:textSize="20sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/gold_amount_text_matches"
        app:layout_constraintStart_toEndOf="@id/gold_amount_text_matches"
        app:layout_constraintTop_toTopOf="@+id/gold_amount_text_matches" />


    <!-- Geri Sayım Sayacı -->

    <ImageView
        android:id="@+id/clockImage"
        android:layout_width="60dp"
        android:layout_height="63dp"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/clock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/tomorrow_b"
        android:text="@string/default_timer"
        android:textColor="@color/infoGameText"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/clockImage"
        app:layout_constraintEnd_toEndOf="@id/clockImage"
        app:layout_constraintStart_toStartOf="@id/clockImage"
        app:layout_constraintTop_toTopOf="@id/clockImage" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="80dp" />

    <TextView
        android:id="@+id/matches_game_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:fontFamily="@font/tomorrow_b"
        android:gravity="center"
        android:text="Aşağıdaki isimleri anlamları ile eşletiriniz"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineStart" />

    
            <Button
                android:id="@+id/m_esma_1"
                style="@style/GreenOutMatchesGameButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_margin="3dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/matches_game_label" />

            <Button
                android:id="@+id/m_esma_2"
                style="@style/GreenOutMatchesGameButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_margin="3dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_esma_1" />

            <Button
                android:id="@+id/m_esma_3"
                style="@style/GreenOutMatchesGameButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_margin="3dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_esma_2" />

            <Button
                android:id="@+id/m_esma_4"
                style="@style/GreenOutMatchesGameButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_margin="3dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_esma_3" />


            <!-- Ortada bir çizgi ekleyelim -->
            <View
                android:id="@+id/center_line"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/colorGray"
                app:layout_constraintBottom_toTopOf="@id/m_answer_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/m_esma_4" />


            <Button
                android:id="@+id/m_answer_1"
                style="@style/BlueOutMatchesGameButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_margin="3dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/m_answer_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:id="@+id/m_answer_2"
                style="@style/BlueOutMatchesGameButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_margin="3dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/m_answer_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:id="@+id/m_answer_3"
                style="@style/BlueOutMatchesGameButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_margin="3dp"
                android:padding="5dp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/m_answer_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/m_answer_4"
        style="@style/BlueOutMatchesGameButton"
        android:layout_width="0dp"
        android:layout_height="63dp"
        android:layout_margin="3dp"
        android:padding="5dp"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>