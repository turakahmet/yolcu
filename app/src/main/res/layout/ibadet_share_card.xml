<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shareLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_sharebg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/shareBaslik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="150dp"
        android:text="@string/testYazisi"
        android:textColor="@color/colorGray"
        android:textSize="15sp"
        android:textStyle="bold" />


    <ImageView
        android:id="@+id/shareImage"
        android:layout_width="wrap_content"
        android:layout_height="130dp"
        android:layout_marginTop="20dp"
        tools:ignore="ContentDescription" />


    <TextView
        android:id="@+id/shareAciklama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/kalamregular"
        android:gravity="center"
        android:text="@string/testYazisi"
        android:textColor="@color/colorCustomDarkGray"
        android:textSize="18sp"
        android:textStyle="bold" />


</LinearLayout>
