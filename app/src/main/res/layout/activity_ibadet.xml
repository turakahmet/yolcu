<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ibadetImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:elevation="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/k_hadis_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dikey kaydırma için ScrollView -->
    <com.islamyolu.app.ibadet.ZoomableScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="5dp"
        android:padding="5dp"
        android:paddingBottom="55dp"
        app:layout_constraintTop_toBottomOf="@id/ibadetImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ibadetConstraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/ibadetHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:gravity="center"
                android:text="@string/testYazisi"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/ibadetConstraintLayout" />

            <TextView
                android:id="@+id/ibadetHeader_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:text="@string/hadisinAnlami"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/redAlertColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ibadetHeader" />

            <TextView
                android:id="@+id/ibadetAciklama1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:text="@string/testYazisi"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="start"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ibadetHeader_label" />

            <TextView
                android:id="@+id/ibadetAciklama1_kaynak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:gravity="start"
                android:text="@string/testYazisi"
                android:textSize="14sp"
                android:textStyle="italic|bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ibadetAciklama1" />

            <TextView
                android:id="@+id/ibadetAciklama2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:text="@string/hadisidenDersCikaralim"
                android:textSize="20sp"
                android:textColor="@color/redAlertColor"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ibadetAciklama1_kaynak" />

            <TextView
                android:id="@+id/ibadetAciklama2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:text="@string/testYazisi"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="start"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ibadetAciklama2_label" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.islamyolu.app.ibadet.ZoomableScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>