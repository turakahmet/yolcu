<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/side_nav_bar"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="20dp"
    android:paddingEnd="15dp"
    android:paddingBottom="20dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/user_avatar_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:layout_marginStart="3dp"
        android:contentDescription="@string/profil_resmi"
        android:src="@drawable/image_shadow_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/user_avatar"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:padding="2dp"
        android:layout_marginTop="5dp"
        android:contentDescription="@string/nav_header_desc"
        android:src="@drawable/man_1"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar_frame"
        app:layout_constraintEnd_toEndOf="@+id/user_avatar_frame"
        app:layout_constraintStart_toStartOf="@+id/user_avatar_frame"
        app:layout_constraintTop_toTopOf="@+id/user_avatar_frame"
        app:shapeAppearanceOverlay="@style/CircleImageView" />


    <TextView
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:paddingTop="@dimen/nav_header_vertical_spacing"
        android:text="@string/nav_header_title"
        android:fontFamily="@font/tomorrow_b"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_avatar_frame" />

    <ImageView
        android:id="@+id/editIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="5dp"
        android:contentDescription="@string/edit_username"
        android:src="@drawable/baseline_edit_24"
        app:layout_constraintBottom_toBottomOf="@id/username"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/username" />

    <!--Total Altın Miktarı -->
    <ImageView
        android:id="@+id/coinImage_word"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_margin="5dp"
        android:contentDescription="@string/altin_icon"
        android:src="@drawable/coin_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/user_avatar_frame" />

    <TextView
        android:id="@+id/total_user_gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:fontFamily="@font/tomorrow_b"
        android:text="@string/default_cost_coin"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/coinImage_word"
        app:layout_constraintEnd_toStartOf="@+id/coinImage_word"
        app:layout_constraintTop_toTopOf="@+id/coinImage_word" />

    <!--Total rozet Miktarı -->

    <ImageView
        android:id="@+id/rozetImage"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_margin="5dp"
        android:contentDescription="@string/rozet_icon"
        android:src="@drawable/medal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/coinImage_word" />

    <TextView
        android:id="@+id/total_rozet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:fontFamily="@font/tomorrow_b"
        android:text="@string/default_value"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/rozetImage"
        app:layout_constraintEnd_toStartOf="@+id/rozetImage"
        app:layout_constraintTop_toTopOf="@+id/rozetImage" />


</androidx.constraintlayout.widget.ConstraintLayout>
