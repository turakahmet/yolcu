<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsRowView içeriği (merge: kök SettingsRowView'in kendisidir) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/settings_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/settings_row_padding_horizontal"
        android:paddingTop="@dimen/settings_row_padding_vertical"
        android:paddingEnd="@dimen/settings_row_padding_horizontal"
        android:paddingBottom="@dimen/settings_row_padding_vertical">

        <FrameLayout
            android:id="@+id/settingsRowIconContainer"
            android:layout_width="@dimen/settings_icon_container"
            android:layout_height="@dimen/settings_icon_container"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_settings_icon">

            <ImageView
                android:id="@+id/settingsRowIcon"
                android:layout_width="@dimen/settings_icon_size"
                android:layout_height="@dimen/settings_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/settings_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Yolcu.Settings.RowTitle"
                tools:text="Bildirimler" />

            <TextView
                android:id="@+id/settingsRowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Yolcu.Settings.RowSubtitle"
                tools:text="5/6 namaz bildirimi aktif" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settingsRowSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/settingsRowChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/baseline_keyboard_arrow_right_24"
            app:tint="@color/settings_text_secondary" />
    </LinearLayout>

    <View
        android:id="@+id/settingsRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="70dp"
        android:background="@color/settings_border"
        android:visibility="gone" />
</merge>
