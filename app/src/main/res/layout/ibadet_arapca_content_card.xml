<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/idCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp">
    <!-- Border için FrameLayout -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_border"
        android:orientation="vertical"
        android:paddingStart="5dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="20dp">
        <!-- Text View to display Course Name -->
        <TextView
            android:id="@+id/idCardViewBaslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="3dp"
            android:text="@string/testYazisi"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/idCardViewImage" />

        <!-- ImageVIew to display our Course Image -->
        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/idCardViewImage"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="#FCFAEE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/idCardViewAciklama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:gravity="start"
            android:padding="5dp"
            android:text="@string/testYazisi"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/idCardViewBaslik" />

        <TextView
            android:id="@+id/idCardViewOkunus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FCFAEE"
            android:fontFamily="sans-serif-condensed"
            android:gravity="start"
            android:padding="5dp"
            android:paddingBottom="10dp"
            android:text="@string/testYazisi"
            android:textColor="@color/colorGray"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/ibadetCardShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_share_24"
            android:contentDescription="@string/share_button_description" />


    </LinearLayout>
</androidx.cardview.widget.CardView>
