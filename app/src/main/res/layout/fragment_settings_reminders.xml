<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/settings_screen_padding">

        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_before_prayer" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowReminderInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/baseline_access_time_filled_24"
                    app:rowSubtitle="@string/settings_reminder_subtitle"
                    app:rowTitle="@string/settings_reminder_title"
                    app:rowType="info" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/reminderMinutesGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_row_padding_horizontal"
                    android:layout_marginEnd="@dimen/settings_row_padding_horizontal"
                    android:layout_marginBottom="@dimen/settings_row_padding_horizontal"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reminder5"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_minutes_5" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reminder10"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_minutes_10" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reminder20"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_minutes_20" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_kerahat" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.islamyolu.app.settings.SettingsRowView
                android:id="@+id/rowKerahat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_settings_hourglass"
                app:rowSubtitle="@string/settings_kerahat_subtitle"
                app:rowTitle="@string/kerahat_vakti"
                app:rowType="toggle" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
