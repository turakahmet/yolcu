<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/settings_screen_padding">

        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_before_prayer" />

        <!-- Süreler vakit başına ayarlanır (Bildirimler → vakit detayı); burada genel süre YOK, yalnızca yönlendirme -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.islamyolu.app.settings.SettingsRowView
                android:id="@+id/rowReminderTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/baseline_access_time_filled_24"
                app:rowSubtitle="@string/settings_reminder_times_subtitle"
                app:rowTitle="@string/settings_reminder_times" />
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_kerahat" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowKerahat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowIcon="@drawable/ic_settings_hourglass"
                    app:rowSubtitle="@string/settings_kerahat_subtitle"
                    app:rowTitle="@string/kerahat_vakti"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowKerahatNotify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/baseline_notifications_24"
                    app:rowSubtitle="@string/settings_kerahat_notify_subtitle"
                    app:rowTitle="@string/settings_kerahat_notify"
                    app:rowType="toggle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
