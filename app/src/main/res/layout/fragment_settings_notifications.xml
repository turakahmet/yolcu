<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/settings_screen_padding">

        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_prayer_notifications" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowNotifyAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowIcon="@drawable/baseline_mosque_24"
                    app:rowSubtitle="@string/settings_notify_all_subtitle"
                    app:rowTitle="@string/settings_notify_all"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowNotifyImsak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowTitle="@string/imsak_vakti"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowNotifySabah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowTitle="@string/sabah_namazi"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowNotifyOgle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowTitle="@string/ogle_namazi"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowNotifyIkindi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowTitle="@string/ikindi_namazi"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowNotifyAksam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowTitle="@string/aksam_namazi"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowNotifyYatsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/yatsi_namazi"
                    app:rowType="toggle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Yolcu.Settings.SectionTitle"
            android:text="@string/settings_section_general" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yolcu.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowAlwaysShow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowDivider="true"
                    app:rowIcon="@drawable/ic_settings_hourglass"
                    app:rowSubtitle="@string/settings_always_show_subtitle"
                    app:rowTitle="@string/vakitHerzamanGoster"
                    app:rowType="toggle" />

                <com.islamyolu.app.settings.SettingsRowView
                    android:id="@+id/rowBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowIcon="@drawable/ic_settings_battery"
                    app:rowTitle="@string/battery_optimization_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
