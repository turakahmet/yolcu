<?xml version="1.0" encoding="utf-8"?>
<!-- Hava kartında tek değer: ikon, etiket (Hissedilen / Nem / Rüzgar) ve değer. İkon ve etiketi
     Dashboard verir. Kalan genişliği diğer değerlerle eşit paylaşır; dar ekranda etiket iki satıra iner. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <ImageView
        android:id="@+id/weather_stat_icon"
        android:layout_width="@dimen/home_weather_stat_icon"
        android:layout_height="@dimen/home_weather_stat_icon"
        android:importantForAccessibility="no"
        app:tint="@color/color_on_header" />

    <TextView
        android:id="@+id/weather_stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/color_on_header_secondary"
        android:textSize="@dimen/home_weather_day_text" />

    <TextView
        android:id="@+id/weather_stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/weather_temp_placeholder"
        android:textColor="@color/color_on_header"
        android:textSize="@dimen/home_weather_stat_value"
        android:textStyle="bold" />
</LinearLayout>