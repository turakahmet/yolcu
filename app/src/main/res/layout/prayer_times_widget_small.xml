<?xml version="1.0" encoding="utf-8"?>
<!-- Küçük widget (≈ ekranın 1/3'ü): yalnızca sıradaki vakit ve kalan süre.
     Kalan süre Chronometer ile sistem tarafından sayılır; dakikalık güncelleme gerekmez. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_next_prayer_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/widget_next_prayer_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_color"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_city_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_color"
        android:textSize="11sp" />
</LinearLayout>
