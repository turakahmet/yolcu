<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.HomeFragment">

    <!-- Dikey kaydırma için ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="55dp"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <!-- Birinci CardView -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_info_game"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- Resim -->

                    <!-- Oyna Butonu -->
                    <ImageView
                        android:id="@+id/info_game_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bilgi_oyunu" />

                    <TextView
                        android:id="@+id/bilgi_oyun_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0dp"
                        android:background="@color/white"
                        android:elevation="1dp"
                        android:fontFamily="@font/tomorrow_b"
                        android:padding="3dp"
                        android:text="@string/bilgi_yarisma"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/play_info_game_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/play"
                        android:fontFamily="@font/tomorrow_b" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- İkinci CardView -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_word_game"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_info_game">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Resim -->
                    <ImageView
                        android:id="@+id/word_game_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kelime_oyunu" />

                    <TextView
                        android:id="@+id/kelime_oyun_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:background="@color/white"
                        android:elevation="1dp"
                        android:fontFamily="@font/tomorrow_b"
                        android:padding="3dp"
                        android:text="@string/kelime_yarismasi"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                    <!-- Oyna Butonu -->
                    <Button
                        android:id="@+id/play_word_game_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="16dp"
                        android:text="@string/play"
                        android:fontFamily="@font/tomorrow_b" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ucuncu CardView -->
            <androidx.cardview.widget.CardView
                android:id="@+id/matches_game"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_word_game">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Resim -->
                    <ImageView
                        android:id="@+id/matches_game_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/esleme_kapak" />

                    <TextView
                        android:id="@+id/matches_game_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:background="@color/white"
                        android:elevation="1dp"
                        android:fontFamily="@font/tomorrow_b"
                        android:padding="3dp"
                        android:text="@string/esleme_yarismasi"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                    <!-- Oyna Butonu -->
                    <Button
                        android:id="@+id/play_matches_game_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="16dp"
                        android:text="@string/play"
                        android:fontFamily="@font/tomorrow_b" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
