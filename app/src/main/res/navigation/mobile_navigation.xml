<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.islamyolu.app.main.Dashboard"
        android:label="@string/menu_anasayfa"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_homeFragment"
            app:destination="@id/nav_home" />
        <action
            android:id="@+id/action_dashboardFragment_to_IslamicDayFragment"
            app:destination="@id/nav_dini_gunler" />
        <action
            android:id="@+id/action_dashboardFragment_to_IbadetFragment"
            app:destination="@id/nav_gallery" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.islamyolu.app.home.HomeFragment"
        android:label="@string/menu_yarisma"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_gallery"
        android:name="com.islamyolu.app.ibadet.IbadetFragment"
        android:label="@string/menu_ibadet"
        tools:layout="@layout/fragment_ibadet" />

    <fragment
        android:id="@+id/nav_compass"
        android:name="com.islamyolu.app.pusula.QiblaCompassFragment"
        android:label="@string/menu_pususla"
        tools:layout="@layout/fragment_compass" />

    <fragment
        android:id="@+id/nav_zekat"
        android:name="com.islamyolu.app.zekat.ZekatHesaplaFragment"
        android:label="@string/menu_zekat_hesapla"
        tools:layout="@layout/fragment_zekat_hesapla" />

    <fragment
        android:id="@+id/nav_muze"
        android:name="com.islamyolu.app.muze.DigitalMuzeFragment"
        android:label="@string/menu_muze"
        tools:layout="@layout/digital_muze_detail" />

    <fragment
        android:id="@+id/navigation_local_products"
        android:name="com.islamyolu.app.localProducts.LocalProductsFragment"
        android:label="@string/local_products_title"
        tools:layout="@layout/fragment_local_products" />

    <activity
        android:id="@+id/nav_monthly_prayer_calendar"
        android:name="com.islamyolu.app.monthlyCalender.MonthlyPrayerActivity"
        android:label="@string/aylikNamazTakvim"
        tools:layout="@layout/activity_monthly_prayer" />

    <activity
        android:id="@+id/nav_dini_gunler"
        android:name="com.islamyolu.app.islamicDays.IslamicDayActivity"
        android:label="@string/diniTakvim"
        tools:layout="@layout/activity_islamic_days" />

    <fragment
        android:id="@+id/nav_rozet"
        android:name="com.islamyolu.app.Rozet.RozetFragment"
        android:label="@string/menu_basari"
        tools:layout="@layout/fragment_rozet" />


</navigation>