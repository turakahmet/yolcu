<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Circular ImageView style -->
    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">55%</item> <!-- This makes it circular -->
    </style>

    <style name="GreenOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="strokeColor">#4CAF50</item> <!-- Yeşil çerçeve -->
        <item name="strokeWidth">3dp</item> <!-- Çerçevenin kalınlığı -->
        <item name="cornerRadius">5dp</item> <!-- Butonun kenarları yuvarlak olacak -->
        <item name="android:textColor">@color/infoGameText</item> <!-- Buton yazısı yeşil -->
    </style>

    <style name="GreenOutMatchesGameButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="strokeColor">#4CAF50</item> <!-- Yeşil çerçeve -->
        <item name="strokeWidth">3dp</item> <!-- Çerçevenin kalınlığı -->
        <item name="cornerRadius">10dp</item> <!-- Butonun kenarları yuvarlak olacak -->
        <item name="android:textColor">@color/infoGameText</item> <!-- Buton yazısı yeşil -->
    </style>
    <style name="BlueOutMatchesGameButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="strokeColor">#2196F3</item> <!-- Yeşil çerçeve -->
        <item name="strokeWidth">3dp</item> <!-- Çerçevenin kalınlığı -->
        <item name="cornerRadius">10dp</item> <!-- Butonun kenarları yuvarlak olacak -->
        <item name="android:textColor">@color/infoGameText</item> <!-- Buton yazısı yeşil -->
    </style>
    <style name="CustomButtonStyle">
        <item name="android:background">@color/colorGray</item> <!-- Kırmızı Renk -->
        <item name="android:textColor">#FFFFFF</item> <!-- Beyaz Metin -->
        <item name="android:textStyle">bold</item> <!-- Kalın Metin -->
        <item name="android:layout_margin">15dp</item> <!-- Buton Kenar Boşluğu -->
        <item name="android:padding">10dp</item> <!-- İç Boşluk -->
    </style>

    <style name="NotificationPrayerTime">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_columnWeight">1</item>
    <item name="android:textSize">14sp</item>
    <item name="android:padding">8dp</item>
    <item name="android:gravity">center</item>
    <item name="android:layout_margin">4dp</item>
</style> 
</resources>
