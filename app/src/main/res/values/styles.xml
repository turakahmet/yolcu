<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Circular ImageView style -->
    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">55%</item> <!-- This makes it circular -->
    </style>

    <style name="GreenOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="strokeColor">#4CAF50</item> <!-- Yeşil çerçeve -->
        <item name="strokeWidth">3dp</item> <!-- Çerçevenin kalınlığı -->
        <item name="cornerRadius">5dp</item> <!-- Butonun kenarları yuvarlak olacak -->
        <item name="android:textColor">@color/infoGameText</item> <!-- Buton yazısı yeşil -->
    </style>

    <style name="GreenOutMatchesGameButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="strokeColor">#4CAF50</item> <!-- Yeşil çerçeve -->
        <item name="strokeWidth">3dp</item> <!-- Çerçevenin kalınlığı -->
        <item name="cornerRadius">10dp</item> <!-- Butonun kenarları yuvarlak olacak -->
        <item name="android:textColor">@color/infoGameText</item> <!-- Buton yazısı yeşil -->
    </style>
    <style name="BlueOutMatchesGameButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="strokeColor">#2196F3</item> <!-- Yeşil çerçeve -->
        <item name="strokeWidth">3dp</item> <!-- Çerçevenin kalınlığı -->
        <item name="cornerRadius">10dp</item> <!-- Butonun kenarları yuvarlak olacak -->
        <item name="android:textColor">@color/infoGameText</item> <!-- Buton yazısı yeşil -->
    </style>

    <!-- ===== Yazı ölçüleri (tasarım sistemi): H1 24sp kalın, H2 18sp yarı kalın, gövde 14sp, açıklama 12sp ===== -->
    <style name="TextAppearance.Yolcu.H1" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Yolcu.H2" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Yolcu.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Yolcu.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <!-- Yeşil başlıktaki uygulama/ekran adı -->
    <style name="TextAppearance.Yolcu.HeaderTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_header</item>
    </style>

    <!-- ===== Ayarlar ekranları (Material 3) ===== -->

    <style name="Theme.Yolcu.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_secondary</item>
        <item name="colorOnPrimary">@color/color_on_secondary</item>
        <item name="colorPrimaryContainer">@color/color_surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/color_text_primary</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorSecondaryContainer">@color/color_surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/color_text_primary</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>
        <item name="colorOutline">@color/color_border</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <!-- Başlık koyu yeşil olduğu için durum çubuğu ikonları her temada açık renk -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Kart: ince çerçeveli, gölgesiz, yuvarlak köşeli -->
    <style name="Widget.Yolcu.Settings.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/settings_card_radius</item>
        <item name="android:layout_marginStart">@dimen/settings_screen_padding</item>
        <item name="android:layout_marginEnd">@dimen/settings_screen_padding</item>
        <item name="android:layout_marginBottom">@dimen/settings_card_spacing</item>
    </style>

    <!-- Kart üstündeki küçük bölüm başlığı -->
    <style name="TextAppearance.Yolcu.Settings.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/color_icon</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Yolcu.Settings.RowTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Yolcu.Settings.RowSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="Widget.Yolcu.Settings.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/settings_section_inset</item>
        <item name="android:layout_marginEnd">@dimen/settings_section_inset</item>
        <item name="android:layout_marginTop">@dimen/settings_card_spacing</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Yolcu.Settings.Section</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>

    <!-- İkincil eylem butonu (çerçeveli); dolu ana buton ilk kullanıldığı görevde eklenecek -->
    <style name="Widget.Yolcu.Settings.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/color_secondary</item>
        <item name="android:textColor">@color/color_secondary</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <!-- Ana Sayfa geri sayım kutuları arasındaki iki nokta -->
    <style name="HomeCountdownSeparator">
        <item name="android:text">@string/countdown_separator</item>
        <item name="android:fontFamily">@font/barlow_semi_condensed_semibold</item>
        <item name="android:textColor">@color/color_on_header</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:shadowColor">@color/color_header_text_shadow</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- Hava kartındaki 5 günlük tahmin satırında günler arası ince çizgi -->
    <style name="HomeWeatherDayDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@color/color_header_glass_stroke</item>
    </style>
    <!-- Yeşil cam panel (tarih, hava, hadis): dolgu bg_glass_panel içteki FrameLayout'ta; köşe motifi
         yalnızca tarih ve hadis kartlarında. Vakit şeridi aynı görünümü bg_home_glass ile alır. -->
    <style name="HomeGlassPanel">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/color_glass_panel_stroke</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
    <!-- Cam panel köşe motifi (img_corner_gold sağ üst köşeye göre çizili; diğer köşelerde
         döndürülmez, aynalanır). Yükseklik ölçüden, genişlik görsel oranından (adjustViewBounds).
         Boyut: büyük panelde home_glass_corner, küçük panelde layout'ta home_glass_corner_small. -->
    <style name="HomeGlassCorner">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/home_glass_corner</item>
        <item name="android:layout_gravity">top|start</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleX">-1</item>
        <item name="android:scaleY">1</item>
        <item name="android:alpha">0.85</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/img_corner_gold</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="HomeGlassCorner.TopEnd">
        <item name="android:layout_gravity">top|end</item>
        <item name="android:scaleX">1</item>
        <item name="android:scaleY">1</item>
    </style>
    <style name="HomeGlassCorner.BottomEnd">
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:scaleX">1</item>
        <item name="android:scaleY">-1</item>
    </style>
    <style name="HomeGlassCorner.BottomStart">
        <item name="android:layout_gravity">bottom|start</item>
        <item name="android:scaleX">-1</item>
        <item name="android:scaleY">-1</item>
    </style>
    <!-- Tarih panelindeki başlık ve alt satır -->
    <style name="HomeDateTitle">
        <item name="android:textColor">@color/color_on_header</item>
        <item name="android:textSize">@dimen/home_date_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="HomeDateSubtitle">
        <item name="android:textColor">@color/color_on_header_secondary</item>
        <item name="android:textSize">@dimen/home_date_sub_text</item>
    </style>
</resources>
