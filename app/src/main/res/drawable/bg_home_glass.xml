<?xml version="1.0" encoding="utf-8"?>
<!-- Yeşil tonlu cam panel (vakit şeridi): bg_glass_panel ile aynı geçiş ve renkler, köşe motifi yok.
     MaterialCardView içinde olmadığı için kenar çizgisi ve köşe yuvarlaklığı burada çizilir. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/color_glass_panel_center"
        android:endColor="@color/color_glass_panel_end"
        android:startColor="@color/color_glass_panel_start" />
    <stroke android:width="1.5dp" android:color="@color/color_glass_panel_stroke" />
    <corners android:radius="16dp" />
</shape>
