<?xml version="1.0" encoding="utf-8"?>
<!-- Motifli cam panel dolgusu: yukarıdan aşağıya yeşil tonlu yarı saydam geçiş. Kenar çizgisi ve köşe
     kırpma MaterialCardView'dan gelir (strokeColor = color_glass_panel_stroke); böylece köşe motifleri
     kartın yuvarlak köşesinde kesilir ve çizgi iki kez çizilmez. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/color_glass_panel_center"
        android:endColor="@color/color_glass_panel_end"
        android:startColor="@color/color_glass_panel_start" />
</shape>
