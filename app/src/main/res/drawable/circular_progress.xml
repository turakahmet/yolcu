<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="oval">
            <solid android:color="#E0E0E0" /> <!-- Gri renk arka plan -->
            <size android:width="200dp" android:height="200dp"/>
        </shape>
    </item>
    <item android:right="8dp" android:left="8dp" android:top="8dp" android:bottom="8dp">
        <shape
            android:shape="oval">
            <solid android:color="@android:color/holo_blue_dark" /> <!-- Mavi renk çubuk -->
            <size android:width="200dp" android:height="200dp"/>
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
